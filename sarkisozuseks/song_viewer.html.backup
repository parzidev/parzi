<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Şarkı ve Akor Görüntüleyici</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        h1 {
            color: #667eea;
            margin-bottom: 30px;
            text-align: center;
            font-size: 2.5em;
        }

        .controls {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .controls input,
        .controls select,
        .controls button {
            padding: 12px 20px;
            border: 2px solid #667eea;
            border-radius: 10px;
            font-size: 16px;
            transition: all 0.3s;
        }

        .controls input {
            flex: 1;
            min-width: 200px;
        }

        .controls button {
            background: #667eea;
            color: white;
            cursor: pointer;
            font-weight: bold;
        }

        .controls button:hover {
            background: #764ba2;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }

        .song-info {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 30px;
        }

        .song-info h2 {
            color: #667eea;
            margin-bottom: 15px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        .info-item {
            background: white;
            padding: 10px 15px;
            border-radius: 8px;
            border-left: 4px solid #667eea;
        }

        .info-item strong {
            color: #764ba2;
            display: block;
            margin-bottom: 5px;
        }

        .chords-section {
            margin-top: 30px;
        }

        .chords-section h3 {
            color: #667eea;
            margin-bottom: 20px;
            font-size: 1.5em;
        }

        .chord-diagrams {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .chord-card {
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            padding: 15px;
            text-align: center;
            transition: all 0.3s;
            cursor: pointer;
        }

        .chord-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
            border-color: #667eea;
        }

        .chord-card svg {
            max-width: 100%;
            height: auto;
        }

        .lyrics-section {
            background: #1a1a2e;
            padding: 30px;
            border-radius: 15px;
            margin-top: 30px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        }

        .lyrics-section h3 {
            color: #f0f0f0;
            margin-bottom: 25px;
            font-size: 1.4em;
        }

        .lyrics-content {
            font-family: 'Courier New', 'Consolas', monospace;
            white-space: pre-wrap;
            line-height: 2;
            font-size: 15px;
            color: #e0e0e0;
            background: #16213e;
            padding: 25px;
            border-radius: 12px;
            border: 1px solid #2a2a4e;
            overflow-x: auto;
        }

        .lyrics-content .chord {
            color: #ff6b6b;
            font-weight: bold;
            background: transparent;
            padding: 2px 4px;
            border-radius: 4px;
            margin: 0 3px;
            display: inline-block;
            text-shadow: 0 0 8px rgba(255, 107, 107, 0.5);
            animation: chordPulse 2s ease-in-out infinite;
        }

        @keyframes chordPulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.85;
            }
        }

        /* Farklı akor tipleri için farklı renkler */
        .lyrics-content .chord:nth-child(4n+1) {
            color: #ff6b6b;
            text-shadow: 0 0 8px rgba(255, 107, 107, 0.5);
        }

        .lyrics-content .chord:nth-child(4n+2) {
            color: #4ecdc4;
            text-shadow: 0 0 8px rgba(78, 205, 196, 0.5);
        }

        .lyrics-content .chord:nth-child(4n+3) {
            color: #ffe66d;
            text-shadow: 0 0 8px rgba(255, 230, 109, 0.5);
        }

        .lyrics-content .chord:nth-child(4n+4) {
            color: #a8dadc;
            text-shadow: 0 0 8px rgba(168, 218, 220, 0.5);
        }

        .rhythm-section {
            background: #fff3cd;
            padding: 20px;
            border-radius: 12px;
            margin-top: 20px;
            border-left: 5px solid #ffc107;
        }

        .rhythm-section h3 {
            color: #856404;
            margin-bottom: 15px;
        }

        .rhythm-patterns {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .rhythm-pattern {
            background: white;
            padding: 8px 15px;
            border-radius: 8px;
            font-family: 'Courier New', monospace;
            font-weight: bold;
            color: #856404;
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: #667eea;
            font-size: 1.2em;
        }

        .error {
            background: #f8d7da;
            color: #721c24;
            padding: 20px;
            border-radius: 10px;
            border-left: 5px solid #f5c6cb;
            margin: 20px 0;
        }

        .stats {
            display: flex;
            justify-content: space-around;
            margin: 20px 0;
            padding: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            color: white;
        }

        .stat-item {
            text-align: center;
        }

        .stat-value {
            font-size: 2em;
            font-weight: bold;
            display: block;
        }

        .stat-label {
            font-size: 0.9em;
            opacity: 0.9;
        }

        .toggle-chords-btn {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(102, 126, 234, 0.3);
        }

        .toggle-chords-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        }

        .toggle-chords-btn:active {
            transform: translateY(0);
        }

        .chords-display {
            margin-top: 20px;
            padding: 25px;
            background: #16213e;
            border-radius: 15px;
            border: 2px solid #2a2a4e;
            display: none;
            /* Başlangıçta gizli */
        }

        .chords-display.show {
            display: block;
            animation: slideDown 0.3s ease;
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .chords-display h4 {
            color: #f0f0f0;
            margin-bottom: 20px;
            font-size: 1.3em;
        }

        .chords-horizontal {
            display: flex;
            gap: 15px;
            overflow-x: auto;
            padding: 10px 0;
            scrollbar-width: thin;
            scrollbar-color: #667eea #f0f0f0;
        }

        .chords-horizontal::-webkit-scrollbar {
            height: 8px;
        }

        .chords-horizontal::-webkit-scrollbar-track {
            background: #f0f0f0;
            border-radius: 10px;
        }

        .chords-horizontal::-webkit-scrollbar-thumb {
            background: #667eea;
            border-radius: 10px;
        }

        .chords-horizontal .chord-card {
            flex: 0 0 auto;
            min-width: 140px;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>🎸 Şarkı ve Akor Görüntüleyici</h1>

        <div class="controls">
            <input type="number" id="songId" placeholder="Şarkı ID (örn: 111)" min="1">
            <button onclick="loadSong()">Şarkıyı Yükle</button>
            <button onclick="randomSong()">Rastgele Şarkı</button>
        </div>

        <div id="content"></div>
    </div>

    <script>
        let songsData = [];

        // Sayfa yüklendiğinde JSON dosyasını oku
        async function loadData() {
            try {
                // Önce ana dosyayı dene
                let response = await fetch('detayli_sarki_bilgileri.json');

                // Bulunamazsa progress dosyasını dene
                if (!response.ok) {
                    console.log('Ana dosya bulunamadı, progress dosyası deneniyor...');
                    response = await fetch('scraping_progress.json');
                }

                if (!response.ok) {
                    throw new Error('Veri dosyası bulunamadı');
                }

                songsData = await response.json();
                showStats();
            } catch (error) {
                document.getElementById('content').innerHTML =
                    `<div class="error">❌ Veri dosyası yüklenemedi: ${error.message}<br>
                    <strong>Aradığım dosyalar:</strong><br>
                    • detayli_sarki_bilgileri.json (final)<br>
                    • scraping_progress.json (ilerleme)<br><br>
                    Bu dosyalardan en az birinin bu HTML ile aynı klasörde olduğundan emin olun.</div>`;
            }
        }

        function showStats() {
            const successCount = songsData.filter(s => s.scrape_status === 'success').length;
            const totalChords = songsData.reduce((sum, s) => sum + (s.kullanilan_akorlar?.length || 0), 0);
            const totalSvgs = songsData.reduce((sum, s) => sum + (s.akor_diyagramlari?.length || 0), 0);

            document.getElementById('content').innerHTML = `
                <div class="stats">
                    <div class="stat-item">
                        <span class="stat-value">${songsData.length}</span>
                        <span class="stat-label">Toplam Şarkı</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-value">${successCount}</span>
                        <span class="stat-label">Başarılı</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-value">${totalChords}</span>
                        <span class="stat-label">Toplam Akor</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-value">${totalSvgs}</span>
                        <span class="stat-label">SVG Diyagram</span>
                    </div>
                </div>
                <div style="text-align: center; color: #667eea; margin: 20px 0;">
                    Bir şarkı görmek için yukarıdan ID girin veya "Rastgele Şarkı" butonuna tıklayın
                </div>
            `;
        }

        function loadSong() {
            const id = parseInt(document.getElementById('songId').value);
            if (!id) {
                alert('Lütfen bir şarkı ID girin');
                return;
            }

            const song = songsData.find(s => s.id === id);
            if (!song) {
                document.getElementById('content').innerHTML =
                    `<div class="error">❌ ID ${id} bulunamadı</div>`;
                return;
            }

            displaySong(song);
        }

        function randomSong() {
            if (songsData.length === 0) return;
            const successSongs = songsData.filter(s => s.scrape_status === 'success');
            const randomSong = successSongs[Math.floor(Math.random() * successSongs.length)];
            document.getElementById('songId').value = randomSong.id;
            displaySong(randomSong);
        }

        async function displaySong(song) {
            let html = `
                <div class="song-info">
                    <h2>${song.sanatci} - ${song.sarkiadi}</h2>
                    <div class="info-grid">
                        <div class="info-item">
                            <strong>ID</strong>
                            ${song.id}
                        </div>
                        <div class="info-item">
                            <strong>Orijinal Ton</strong>
                            ${song.orjinal_ton || '-'}
                        </div>
                        <div class="info-item">
                            <strong>Kapo</strong>
                            ${song.kapo || '0'}
                        </div>
                        <div class="info-item">
                            <strong>Kullanılan Akor Sayısı</strong>
                            ${song.kullanilan_akorlar?.length || 0}
                        </div>
                    </div>
                </div>
            `;

            // Ritim bilgileri
            if (song.ritimler && song.ritimler.length > 0) {
                html += `
                    <div class="rhythm-section">
                        <h3>🥁 Ritim Kalıpları</h3>
                        <div class="rhythm-patterns">
                            ${song.ritimler.map(r => `<div class="rhythm-pattern">${r}</div>`).join('')}
                        </div>
                    </div>
                `;
            }

            // Akor diyagramları
            if (song.akor_diyagramlari && song.akor_diyagramlari.length > 0) {
                html += `
                    <div class="chords-section">
                        <h3>🎸 Akor Diyagramları</h3>
                        <div class="chord-diagrams" id="diagrams">
                            ${await loadDiagrams(song.akor_diyagramlari)}
                        </div>
                    </div>
                `;
            }

            // Şarkı sözleri ve akorlar
            if (song.akorlar_ve_sozler) {
                const formattedLyrics = formatLyrics(song.akorlar_ve_sozler);
                const uniqueChords = extractUniqueChords(song.akorlar_ve_sozler);

                html += `
                    <div class="lyrics-section">
                        <h3>📝 Şarkı Sözleri ve Akorlar</h3>
                        <div class="lyrics-content">${formattedLyrics}</div>
                        
                        ${uniqueChords.length > 0 ? `
                            <button class="toggle-chords-btn" onclick="toggleChords()">
                                🎸 Akor Diyagramlarını Göster (${uniqueChords.length} akor)
                            </button>
                            
                            <div class="chords-display" id="chord-diagrams-section">
                                <h4>🎸 Kullanılan Akorlar</h4>
                                <div class="chords-horizontal">
                                    ${await loadDiagramsForChords(uniqueChords)}
                                </div>
                            </div>
                        ` : ''}
                    </div>
                `;
            }

            document.getElementById('content').innerHTML = html;
        }

        function toggleChords() {
            const section = document.getElementById('chord-diagrams-section');
            const btn = document.querySelector('.toggle-chords-btn');

            if (section.classList.contains('show')) {
                section.classList.remove('show');
                const chordCount = section.querySelector('.chords-horizontal').children.length;
                btn.textContent = `🎸 Akor Diyagramlarını Göster (${chordCount} akor)`;
            } else {
                section.classList.add('show');
                const chordCount = section.querySelector('.chords-horizontal').children.length;
                btn.textContent = `🎸 Akor Diyagramlarını Gizle (${chordCount} akor)`;
            }
        }

        function extractUniqueChords(htmlLyrics) {
            // HTML içeriğinden akorları çıkar
            // Akorlar direkt metinde yazılı, <span class="c"> yok
            const chords = [];

            // HTML'i temizle
            let text = htmlLyrics
                .replace(/<br\/?>/g, '\n')
                .replace(/<[^>]+>/g, '')
                .replace(/&nbsp;/g, ' ');

            // Her satırı kontrol et
            const lines = text.split('\n');

            for (const line of lines) {
                // Akor patternleri: Büyük harf + opsiyonel # veya b + opsiyonel m/maj/min/dim/aug/sus/add + opsiyonel sayı
                // Örnek: C, C#, Cm, C7, Cmaj7, C#m7, Dm7, F#m, Asus2, etc.
                const chordPattern = /\b([A-G][#b]?(?:m|maj|min|dim|aug|sus|add)?[0-9]*)\b/g;

                let match;
                while ((match = chordPattern.exec(line)) !== null) {
                    const chord = match[1];

                    // Sadece akor satırlarından al (çok fazla boşluk varsa muhtemelen akor satırı)
                    // Veya satır başında akor varsa
                    if (line.trim().split(/\s+/).length <= 10 || line.trim().indexOf(chord) === 0) {
                        chords.push(chord);
                    }
                }
            }

            // Benzersiz akorları al, sırala ve filtrele
            const unique = [...new Set(chords)].sort();

            // Tek harf olanları filtrele (A-G harfleri şarkı sözü olabilir)
            return unique.filter(chord => chord.length > 1 || /[#b]/.test(chord));
        }

        async function loadDiagramsForChords(chords) {
            let html = '';
            for (const chord of chords) {
                // Akor diyagramını bul (SVG dosyası olarak)
                // Format: songid_songname_chordname.svg
                // Ancak burada direkt chord_diagram_generator ile üretilen test akorlarından arayabiliriz

                // Önce test_chords klasöründen deneyelim
                try {
                    // # karakteri için URL encoding gerekli!
                    const encodedChord = encodeURIComponent(chord);
                    const response = await fetch(`test_chords/${encodedChord}.svg`);
                    if (response.ok) {
                        const svgContent = await response.text();
                        html += `
                            <div class="chord-card">
                                ${svgContent}
                            </div>
                        `;
                        continue;
                    }
                } catch (error) {
                    // Bulunamadı, devam et
                }

                // Bulunamazsa placeholder göster
                html += `
                    <div class="chord-card">
                        <div style="padding: 20px; color: #999;">
                            <strong>${chord}</strong>
                            <br><small>Diyagram bulunamadı</small>
                        </div>
                    </div>
                `;
            }
            return html;
        }

        async function loadDiagrams(diagrams) {
            let html = '';
            for (const diagram of diagrams) {
                try {
                    const response = await fetch(`svg_diyagramlar/${diagram}`);
                    const svgContent = await response.text();
                    html += `
                        <div class="chord-card">
                            ${svgContent}
                        </div>
                    `;
                } catch (error) {
                    console.error(`SVG yüklenemedi: ${diagram}`, error);
                }
            }
            return html || '<div>SVG diyagramları yüklenemedi</div>';
        }

        function formatLyrics(htmlLyrics) {
            // <pre> etiketlerini kaldır
            let lyrics = htmlLyrics.replace(/<pre[^>]*>/g, '').replace(/<\/pre>/g, '');

            // <br/> ve <br> taglarını \n'e çevir
            lyrics = lyrics.replace(/<br\/?>/g, '\n');

            // HTML taglarını temizle
            lyrics = lyrics.replace(/<[^>]+>/g, '');
            lyrics = lyrics.replace(/&nbsp;/g, ' ');

            // Akorları tespit et ve renkli span ile sarmal
            const lines = lyrics.split('\n');
            const formattedLines = lines.map(line => {
                // Akor pattern: Başta veya boşluktan sonra gelen büyük harf + opsiyonel modifiers
                const chordPattern = /\b([A-G][#b]?(?:m|maj|min|dim|aug|sus|add)?[0-9]*)\b/g;

                // Eğer satırda çok fazla boşluk varsa (akor satırı) veya kısa satır ise
                const wordCount = line.trim().split(/\s+/).length;

                if (wordCount <= 10 && line.trim().length > 0) {
                    // Muhtemelen akor satırı - akorları highlight et
                    return line.replace(chordPattern, '<span class="chord">$1</span>');
                }

                return line;
            });

            return formattedLines.join('\n');
        }

        // Sayfa yüklenince veriyi getir
        loadData();
    </script>
</body>

</html>